            QLineEdit:focus, QTextEdit:focus, QComboBox:focus { border: 2px solid #2563eb; }
            QPushButton { background: #2563eb; color: #ffffff; border: none; border-radius: 6px; padding: 7px 12px; }
            QPushButton:hover { background: #1d4ed8; }
            QPushButton:pressed { background: #1e40af; }
            QPushButton:disabled { background: #9ca3af; }
            QTableWidget { background: #ffffff; gridline-color: #e5e7eb; border: 1px solid #e5e7eb; border-radius: 6px; alternate-background-color: #fff7ed; }
            QHeaderView::section { background: #fed7aa; padding: 6px; border: none; font-weight: bold; color: #111827; }
            QSplitter::handle { background: #d1d5db; width: 3px; }
            QRadioButton, QCheckBox { spacing: 6px; }
            QFrame { color: #e5e7eb; }
            QComboBox QAbstractItemView { background: #ffffff; }
            """
        )

    def _contrato(self):
        if self.rb_indef.isChecked():
            return "Indefinido"
        if self.rb_plazo.isChecked():
            return "Plazo fijo"
        if self.rb_prac.isChecked():
            return "Prácticas"
        if self.rb_cas.isChecked():
            return "CAS"
        return ""

    def _habilidades(self):
        h = []
        if self.chk_com.isChecked():
            h.append("Comunicación")
        if self.chk_team.isChecked():
            h.append("Trabajo en equipo")
        if self.chk_ingles.isChecked():
            h.append("Inglés")
        if self.chk_sql.isChecked():
            h.append("SQL")
        if self.chk_python.isChecked():
            h.append("Python")
        if self.chk_lider.isChecked():
            h.append("Liderazgo")
        return ", ".join(h)

    def _set_contrato(self, c):
        c = (c or "").lower()
        self.rb_indef.setChecked(c == "indefinido")
        self.rb_plazo.setChecked("plazo" in c)
        self.rb_prac.setChecked("prácticas" in c or "practicas" in c)
        self.rb_cas.setChecked(c == "cas")

    def _set_hab(self, t):
        t = (t or "").lower()
        self.chk_com.setChecked("comunicación" in t or "comunicacion" in t)
        self.chk_team.setChecked("equipo" in t)
        self.chk_ingles.setChecked("inglés" in t or "ingles" in t)
        self.chk_sql.setChecked("sql" in t)
        self.chk_python.setChecked("python" in t)
        self.chk_lider.setChecked("liderazgo" in t)

    def validar(self, d):
        if not d.get("id"):
            return False, "DNI/ID es obligatorio."
        if not d.get("nombre"):
            return False, "Nombre completo es obligatorio."
        if d.get("departamento") == "-- Seleccionar --":
            return False, "Debe seleccionar departamento."
        if d.get("cargo") == "-- Seleccionar --":
            return False, "Debe seleccionar cargo."
        try:
            float((d.get("sueldo") or "0").replace(",", "."))
        except ValueError:
            return False, "Sueldo base debe ser numérico."
        correo = d.get("correo") or ""
        if correo and "@" not in correo:
            return False, "Correo no válido."
        if not d.get("contrato"):
            return False, "Debe seleccionar tipo de contrato."
        return True, ""

    def limpiar(self):
        self.txt_id.clear()
        self.txt_nombre.clear()
        self.cmb_dep.setCurrentIndex(0)
        self.cmb_cargo.setCurrentIndex(0)
        self.txt_sueldo.clear()
        self.txt_tel.clear()
        self.txt_correo.clear()
        self.rb_indef.setAutoExclusive(False)
        self.rb_plazo.setAutoExclusive(False)
        self.rb_prac.setAutoExclusive(False)
        self.rb_cas.setAutoExclusive(False)
        self.rb_indef.setChecked(False)
        self.rb_plazo.setChecked(False)
        self.rb_prac.setChecked(False)
        self.rb_cas.setChecked(False)
        self.rb_indef.setAutoExclusive(True)
        self.rb_plazo.setAutoExclusive(True)
        self.rb_prac.setAutoExclusive(True)
        self.rb_cas.setAutoExclusive(True)
        self.chk_com.setChecked(False)
        self.chk_team.setChecked(False)
        self.chk_ingles.setChecked(False)
        self.chk_sql.setChecked(False)
        self.chk_python.setChecked(False)
        self.chk_lider.setChecked(False)
        self.txt_obs.clear()
        self.editando_index = -1
        self.btn_registrar.setEnabled(True)
        self.btn_editar.setEnabled(False)
        self.btn_cancelar.setVisible(False)
        self.tabla.clearSelection()
        self.txt_id.setFocus()

    def registrar(self):
        d = {
            "id": self.txt_id.text().strip(),
            "nombre": self.txt_nombre.text().strip(),
            "departamento": self.cmb_dep.currentText(),
            "cargo": self.cmb_cargo.currentText(),
            "sueldo": self.txt_sueldo.text().strip(),
            "telefono": self.txt_tel.text().strip(),
            "correo": self.txt_correo.text().strip(),
            "contrato": self._contrato(),
            "habilidades": self._habilidades(),
            "fecha": datetime.now().strftime("%d/%m/%Y"),
            "observaciones": self.txt_obs.toPlainText().strip(),
        }
        ok, msg = self.validar(d)
        if not ok:
            QMessageBox.warning(self, "Validación", msg)
            return
        if any(r["id"].lower() == d["id"].lower() for r in self.registros):
            QMessageBox.warning(self, "Validación", "Ya existe empleado con ese ID/DNI.")
            return
        if ConfirmacionDialog("¿Confirmas registrar este empleado?", self).exec() == QDialog.Accepted:
            self.registros.append(d)
            self.limpiar()
            self._mostrar_tabla()
            QMessageBox.information(self, "Éxito", "Empleado registrado correctamente.")

    def _mostrar_tabla(self):
        self.tabla.setRowCount(len(self.registros))
        for i, r in enumerate(self.registros):
            self.tabla.setItem(i, 0, QTableWidgetItem(r["id"]))
            self.tabla.setItem(i, 1, QTableWidgetItem(r["nombre"]))
            self.tabla.setItem(i, 2, QTableWidgetItem(r["departamento"]))
            self.tabla.setItem(i, 3, QTableWidgetItem(r["cargo"]))
            self.tabla.setItem(i, 4, QTableWidgetItem(r["contrato"]))
            self.tabla.setItem(i, 5, QTableWidgetItem(r["sueldo"]))
            self.tabla.setItem(i, 6, QTableWidgetItem(r["correo"]))
            self.tabla.setItem(i, 7, QTableWidgetItem(r["fecha"]))
        self.lbl_total.setText(f"Total de empleados: {len(self.registros)}")

    def cargar_para_editar(self):
        if not self.registros:
            return
        rows = self.tabla.selectionModel().selectedRows()
        if not rows:
            QMessageBox.information(self, "Editar", "Seleccione una fila.")
            return
        idx = rows[0].row()
        r = self.registros[idx]
        self.editando_index = idx
        self.txt_id.setText(r["id"])
        self.txt_nombre.setText(r["nombre"])
        self.cmb_dep.setCurrentText(r["departamento"])
        self.cmb_cargo.setCurrentText(r["cargo"])
        self.txt_sueldo.setText(r["sueldo"])
        self.txt_tel.setText(r["telefono"])
        self.txt_correo.setText(r["correo"])
        self._set_contrato(r["contrato"])
        self._set_hab(r["habilidades"])
        self.txt_obs.setPlainText(r.get("observaciones", ""))
        self.btn_registrar.setEnabled(False)
        self.btn_editar.setEnabled(True)
        self.btn_cancelar.setVisible(True)
        self.txt_id.setFocus()

    def guardar_edicion(self):
        if self.editando_index < 0:
            return
        d = {
            "id": self.txt_id.text().strip(),
            "nombre": self.txt_nombre.text().strip(),
            "departamento": self.cmb_dep.currentText(),
            "cargo": self.cmb_cargo.currentText(),
            "sueldo": self.txt_sueldo.text().strip(),
            "telefono": self.txt_tel.text().strip(),
            "correo": self.txt_correo.text().strip(),
            "contrato": self._contrato(),
            "habilidades": self._habilidades(),
            "fecha": self.registros[self.editando_index].get("fecha", datetime.now().strftime("%d/%m/%Y")),
            "observaciones": self.txt_obs.toPlainText().strip(),
        }
        ok, msg = self.validar(d)
        if not ok:
            QMessageBox.warning(self, "Validación", msg)
            return
        for i, r in enumerate(self.registros):
            if i != self.editando_index and r["id"].lower() == d["id"].lower():
                QMessageBox.warning(self, "Validación", "ID/DNI ya existe en otro registro.")
                return
        if ConfirmacionDialog("¿Confirmas guardar los cambios?", self).exec() == QDialog.Accepted:
            self.registros[self.editando_index] = d
            self.cancelar_edicion()
            self._mostrar_tabla()
            QMessageBox.information(self, "Éxito", "Empleado editado correctamente.")

    def cancelar_edicion(self):
        self.limpiar()

    def eliminar(self):
        if not self.registros:
            QMessageBox.information(self, "Eliminar", "No hay registros.")
            return
        rows = self.tabla.selectionModel().selectedRows()
        if not rows:
            QMessageBox.information(self, "Eliminar", "Seleccione una fila.")
            return
        idx = rows[0].row()
        nombre = self.registros[idx]["nombre"]
        if ConfirmacionDialog(f"¿Confirmas eliminar a '{nombre}'?", self).exec() == QDialog.Accepted:
            del self.registros[idx]
            if self.editando_index == idx:
                self.cancelar_edicion()
            elif self.editando_index > idx:
                self.editando_index -= 1
            self._mostrar_tabla()
            QMessageBox.information(self, "Éxito", "Registro eliminado correctamente.")

    def buscar(self):
        t = (self.txt_id.text().strip() or self.txt_nombre.text().strip()).lower()
        if not t:
            QMessageBox.information(self, "Buscar", "Ingrese ID/DNI o nombre.")
            return
        res = [r for r in self.registros if t in r["id"].lower() or t in r["nombre"].lower()]
        if not res:
            QMessageBox.information(self, "Buscar", "No se encontraron empleados.")
            return
        r = res[0]
        try:
            idx = self.registros.index(r)
        except ValueError:
            idx = -1
        if idx >= 0:
            self.tabla.selectRow(idx)
            self.cargar_para_editar()
        DetalleEmpleadoDialog(r, self).exec()

    def mostrar_info(self):
        if not self.registros:
            QMessageBox.information(self, "Información", "No hay registros.")
            return
        rows = self.tabla.selectionModel().selectedRows()
        if not rows:
            QMessageBox.information(self, "Información", "Seleccione un registro.")
            return
        idx = rows[0].row()
        DetalleEmpleadoDialog(self.registros[idx], self).exec()


def main():
    app = QApplication(sys.argv)
    w = SistemaEmpleados()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()

