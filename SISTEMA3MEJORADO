class DetalleEmpleadoDialog(QDialog):
    def __init__(self, datos, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Ficha del Empleado")
        self.setFixedSize(460, 420)
        self.setModal(True)

        v = QVBoxLayout(self)
        t = QLabel("Ficha de información del empleado")
        ft = QFont()
        ft.setPointSize(12)
        ft.setBold(True)
        t.setFont(ft)
        t.setAlignment(Qt.AlignCenter)
        v.addWidget(t)

        f = QFormLayout()
        f.addRow("DNI/ID:", QLabel(datos.get("id", "-")))
        f.addRow("Nombres y Apellidos:", QLabel(datos.get("nombre", "-")))
        f.addRow("Departamento:", QLabel(datos.get("departamento", "-")))
        f.addRow("Cargo:", QLabel(datos.get("cargo", "-")))
        f.addRow("Tipo de contrato:", QLabel(datos.get("contrato", "-")))
        f.addRow("Sueldo base:", QLabel(datos.get("sueldo", "-")))
        f.addRow("Teléfono:", QLabel(datos.get("telefono", "-")))
        f.addRow("Correo:", QLabel(datos.get("correo", "-")))
        f.addRow("Fecha ingreso:", QLabel(datos.get("fecha", "-")))
        f.addRow("Habilidades:", QLabel(datos.get("habilidades", "-") or "-"))
        f.addRow("Observaciones:", QLabel(datos.get("observaciones", "-") or "-"))
        v.addLayout(f)

        h = QHBoxLayout()
        b = QPushButton("Cerrar")
        b.setDefault(True)
        b.clicked.connect(self.accept)
        h.addStretch()
        h.addWidget(b)
        v.addLayout(h)


class ConfirmacionDialog(QDialog):
    def __init__(self, mensaje, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Confirmación")
        self.setFixedSize(340, 120)
        self.setModal(True)
        v = QVBoxLayout(self)
        l = QLabel(mensaje)
        l.setWordWrap(True)
        l.setAlignment(Qt.AlignCenter)
        v.addWidget(l)
        h = QHBoxLayout()
        si = QPushButton("Sí")
        no = QPushButton("No")
        no.setDefault(True)
        si.clicked.connect(self.accept)
        no.clicked.connect(self.reject)
        h.addStretch()
        h.addWidget(si)
        h.addWidget(no)
        h.addStretch()
        v.addLayout(h)


